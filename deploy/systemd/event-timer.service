# Autostart auf Raspberry Pi / Linux-Server
#   sudo cp event-timer /usr/local/bin/ && sudo chmod +x /usr/local/bin/event-timer
#   sudo cp deploy/systemd/event-timer.service /etc/systemd/system/
#   sudo systemctl enable --now event-timer
[Unit]
Description=Event Timer
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/event-timer --no-browser --data /var/lib/event-timer/event-timer-data.json
StateDirectory=event-timer
DynamicUser=yes
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
