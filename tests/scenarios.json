      { "at": 2000, "do": { "type": "agenda.update", "itemId": "s2", "patch": { "durationMs": 600000 } } },
      { "at": 2000, "expect": { "agenda.items.1.planMs": 600000 } },
      { "at": 3000, "do": { "type": "agenda.next" } },
      { "at": 4000, "do": { "type": "agenda.update", "itemId": "s2", "patch": { "durationMs": 300000, "buffer": false } } },
      { "at": 4000, "expect": { "agenda.items.1.durationMs": 300000, "agenda.items.1.planMs": 600000, "agenda.items.1.buffer": false } },
      { "at": 5000, "do": { "type": "agenda.add", "item": { "title": "C" } } },
      { "at": 5000, "expect": { "agenda.items.2.planMs": 0, "agenda.items.2.durationMs": 600000 } },
      { "at": 6000, "do": { "type": "agenda.reset" } },
      { "at": 6000, "expect": { "agenda.items.1.planMs": 300000, "agenda.items.2.planMs": 600000 } }
    ]
  }
]
