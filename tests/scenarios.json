          "id": "t1",
          "visible": false
        }
      },
      {
        "at": 0,
        "expect": {
          "timers.0.message.visible": false
        }
      },
      {
        "at": 0,
        "do": {
          "type": "timer.messageClear",
          "id": "t1"
        }
      },
      {
        "at": 0,
