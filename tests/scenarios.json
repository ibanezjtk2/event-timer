  {
    "name": "run of show with drift",
    "steps": [
      {
        "at": 0,
        "do": {
          "type": "agenda.replace",
          "items": [
            {
              "title": "Begrüßung",
              "speaker": "Anna",
              "durationMs": 300000
            },
            {
              "title": "Keynote",
              "speaker": "Ben",
              "durationMs": 1200000
            },
            {
              "title": "Panel",
              "durationMs": 900000
            }
          ]
        }
      },
      {
        "at": 0,
        "expect": {
          "agenda.items.0.id": "s1",
          "agenda.items.2.id": "s3",
          "agenda.cursor": -1,
          "agendaView.totalPlanned": 2400000
        }
      },
      {
        "at": 1000,
        "do": {
          "type": "agenda.next"
        }
      },
      {
        "at": 1000,
        "expect": {
          "agenda.cursor": 0,
          "timers.0.segmentId": "s1",
          "timers.0.running": true,
          "agenda.items.0.startedAt": 1000
        }
      },
      {
        "at": 421000,
        "expect": {
          "view.t1.ms": -120000,
          "agendaView.drift": 120000
        }
      },
      {
        "at": 421000,
        "do": {
          "type": "agenda.next"
        }
      },
      {
        "at": 421000,
        "expect": {
          "agenda.items.0.endedAt": 421000,
          "agenda.cursor": 1,
          "view.t1.ms": 1200000,
          "agendaView.drift": 120000,
          "agendaView.projectedEnd": 2521000
        }
      },
      {
        "at": 1021000,
        "expect": {
          "agendaView.drift": 120000,
          "agendaView.projectedEnd": 2521000
        }
      },
      {
        "at": 1021000,
        "do": {
          "type": "agenda.next"
        }
      },
      {
        "at": 1021000,
        "expect": {
          "agendaView.drift": -480000
        }
      },
      {
        "at": 1021000,
        "do": {
          "type": "agenda.prev"
        }
      },
      {
        "at": 1021000,
        "expect": {
          "agenda.cursor": 1,
          "agenda.items.1.startedAt": 1021000,
          "agenda.items.2.startedAt": null
        }
      },
      {
        "at": 1021000,
        "do": {
          "type": "agenda.next"
        }
      },
      {
        "at": 1021000,
        "do": {
          "type": "agenda.next"
        }
      },
      {
        "at": 1021000,
        "expect": {
          "agenda.cursor": 3,
          "agendaView.done": true,
          "timers.0.segmentId": null,
          "timers.0.running": false
        }
      },
      {
        "at": 1021000,
        "do": {
          "type": "agenda.next"
        },
        "changed": false
      },
      {
        "at": 1021000,
        "do": {
          "type": "agenda.reset"
        }
      },
      {
        "at": 1021000,
        "expect": {
          "agenda.cursor": -1,
          "agenda.items.0.startedAt": null,
          "view.t1.state": "idle"
        }
      }
    ]
  },
  {
    "name": "run of show without autostart",
    "steps": [
      {
        "at": 0,
        "do": {
          "type": "agenda.settings",
          "autoStart": false,
          "plannedStart": "09:30"
        }
      },
      {
        "at": 0,
        "do": {
          "type": "agenda.add",
          "item": {
            "title": "A",
            "durationMs": 60000
          }
        }
      },
      {
        "at": 0,
        "do": {
          "type": "agenda.add",
          "item": {
            "title": "B",
            "durationMs": 120000
          },
          "index": 0
        }
      },
      {
        "at": 0,
        "expect": {
          "agenda.items.0.title": "B",
          "agenda.plannedStart": "09:30"
        }
      },
      {
        "at": 5000,
        "do": {
          "type": "agenda.go",
          "index": 1
        }
      },
      {
        "at": 5000,
        "expect": {
          "timers.0.running": false,
          "agenda.items.1.startedAt": null,
          "view.t1.ms": 60000
        }
      },
      {
        "at": 9000,
        "do": {
          "type": "timer.start",
          "id": "t1"
        }
      },
      {
        "at": 9000,
        "expect": {
          "agenda.items.1.startedAt": 9000
        }
      },
      {
        "at": 9000,
        "do": {
          "type": "agenda.move",
          "itemId": "s1",
          "to": 0
        }
      },
      {
        "at": 9000,
        "expect": {
          "agenda.cursor": 0,
          "agenda.items.0.title": "A"
        }
      },
      {
        "at": 9000,
        "do": {
          "type": "agenda.update",
          "itemId": "s2",
          "patch": {
            "durationMs": 30000,
            "title": "B2"
          }
        }
      },
      {
        "at": 9000,
        "expect": {
          "agenda.items.1.durationMs": 30000,
          "agenda.items.1.title": "B2"
        }
      },
      {
        "at": 9000,
        "do": {
          "type": "agenda.remove",
          "itemId": "s1"
        }
      },
      {
        "at": 9000,
        "expect": {
          "agenda.cursor": -1,
          "timers.0.segmentId": null
        }
      },
      {
        "at": 9000,
        "do": {
          "type": "agenda.settings",
          "plannedStart": "25:00"
        }
      },
      {
        "at": 9000,
        "expect": {
          "agenda.plannedStart": ""
        }
      }
    ]
  },
