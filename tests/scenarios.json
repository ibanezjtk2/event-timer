[
  {
    "name": "start, pause, resume countdown",
    "steps": [
      {
        "at": 1000,
        "do": {
          "type": "timer.set",
          "id": "t1",
          "ms": 300000
        }
      },
      {
        "at": 1000,
        "expect": {
          "view.t1.state": "idle",
          "view.t1.ms": 300000
        }
      },
      {
        "at": 2000,
        "do": {
          "type": "timer.start",
          "id": "t1"
        }
      },
      {
        "at": 62000,
        "expect": {
          "view.t1.ms": 240000,
          "view.t1.state": "running",
          "timers.0.running": true
        }
      },
      {
        "at": 62000,
        "do": {
          "type": "timer.pause",
          "id": "t1"
        }
      },
      {
        "at": 99000,
        "expect": {
          "view.t1.ms": 240000,
          "view.t1.state": "paused"
        }
      },
      {
        "at": 100000,
        "do": {
          "type": "timer.toggle",
          "id": "t1"
        }
      },
      {
        "at": 110000,
        "expect": {
          "view.t1.ms": 230000
        }
      },
      {
        "at": 110000,
        "do": {
          "type": "timer.reset",
          "id": "t1"
        }
      },
      {
        "at": 110000,
        "expect": {
          "view.t1.ms": 300000,
          "view.t1.state": "idle",
          "rev": 5
        }
      }
    ]
  },
  {
    "name": "phases and overtime",
    "steps": [
      {
        "at": 0,
        "do": {
          "type": "timer.set",
          "id": "t1",
          "ms": 180000,
          "start": true
        }
      },
      {
        "at": 30000,
        "expect": {
          "view.t1.phase": "normal"
        }
      },
      {
        "at": 60000,
        "expect": {
          "view.t1.phase": "warn"
        }
      },
      {
        "at": 120000,
        "expect": {
          "view.t1.phase": "crit"
        }
      },
      {
        "at": 185000,
        "expect": {
          "view.t1.phase": "over",
          "view.t1.ms": -5000,
          "view.t1.state": "running",
          "view.t1.over": true
        }
      }
    ]
  },
  {
    "name": "no overtime stops at zero",
    "steps": [
      {
        "at": 0,
        "do": {
          "type": "timer.update",
          "id": "t1",
          "patch": {
            "overtime": false
          }
        }
      },
      {
        "at": 0,
        "do": {
          "type": "timer.set",
          "id": "t1",
          "ms": 60000,
          "start": true
        }
      },
      {
        "at": 70000,
        "expect": {
          "view.t1.ms": 0,
          "view.t1.state": "finished"
        }
      },
      {
        "at": 71000,
        "do": {
          "type": "timer.message",
          "id": "t1",
          "text": "hi"
        }
      },
      {
        "at": 71000,
        "expect": {
          "timers.0.running": false,
          "timers.0.baseMs": 0,
          "view.t1.state": "finished"
        }
      },
      {
        "at": 72000,
        "do": {
          "type": "timer.start",
          "id": "t1"
        }
      },
      {
        "at": 72000,
        "expect": {
          "timers.0.running": false
        }
      },
      {
        "at": 72000,
        "do": {
          "type": "timer.adjust",
          "id": "t1",
          "ms": 30000
        }
      },
      {
        "at": 72000,
        "expect": {
          "view.t1.ms": 30000,
          "view.t1.state": "paused"
        }
      }
    ]
  },
  {
    "name": "adjust while running extends duration",
    "steps": [
      {
        "at": 0,
        "do": {
          "type": "timer.set",
          "id": "t1",
          "ms": 60000,
          "start": true
        }
      },
      {
        "at": 10000,
        "do": {
          "type": "timer.adjust",
          "id": "t1",
          "ms": 60000
        }
      },
      {
        "at": 10000,
        "expect": {
          "view.t1.ms": 110000,
          "timers.0.durationMs": 110000
        }
      },
      {
        "at": 20000,
        "expect": {
          "view.t1.ms": 100000
        }
      },
      {
        "at": 20000,
        "do": {
          "type": "timer.adjust",
          "id": "t1",
          "ms": -30000
        }
      },
      {
        "at": 20000,
        "expect": {
          "view.t1.ms": 70000,
          "timers.0.durationMs": 110000
        }
      },
      {
        "at": 20000,
        "do": {
          "type": "timer.adjust",
          "id": "t1",
          "ms": 0
        },
        "changed": false
      }
    ]
  },
  {
    "name": "count up with soft limit",
    "steps": [
      {
        "at": 0,
        "do": {
          "type": "timer.update",
          "id": "t1",
          "patch": {
            "kind": "countup"
          }
        }
      },
      {
        "at": 0,
        "expect": {
          "view.t1.ms": 0,
          "view.t1.state": "idle"
        }
      },
      {
        "at": 0,
        "do": {
          "type": "timer.set",
          "id": "t1",
          "ms": 300000,
          "start": true
        }
      },
      {
        "at": 45000,
        "expect": {
          "view.t1.ms": 45000,
          "view.t1.phase": "normal",
          "view.t1.state": "running"
        }
      },
      {
        "at": 245000,
        "expect": {
          "view.t1.phase": "crit"
        }
      },
      {
        "at": 310000,
        "expect": {
          "view.t1.phase": "over",
          "view.t1.ms": 310000
        }
      },
      {
        "at": 130000,
        "do": {
          "type": "timer.reset",
          "id": "t1"
        }
      },
      {
        "at": 130000,
        "expect": {
          "view.t1.ms": 0
        }
      }
    ]
  },
  {
    "name": "count to time of day",
    "steps": [
      {
        "at": 1000000,
        "do": {
          "type": "timer.target",
          "id": "t1",
          "at": 1600000,
          "label": "14:30"
        }
      },
      {
        "at": 1000000,
        "expect": {
          "view.t1.ms": 600000,
          "view.t1.state": "running",
          "timers.0.kind": "clock"
        }
      },
      {
        "at": 1000000,
        "do": {
          "type": "timer.pause",
          "id": "t1"
        }
      },
      {
        "at": 1300000,
        "expect": {
          "view.t1.ms": 300000
        }
      },
      {
        "at": 1700000,
        "expect": {
          "view.t1.ms": -100000,
          "view.t1.phase": "over"
        }
      },
      {
        "at": 1700000,
        "do": {
          "type": "timer.reset",
          "id": "t1"
        }
      },
      {
        "at": 1700000,
        "expect": {
          "timers.0.kind": "countdown",
          "view.t1.state": "idle"
        }
      }
    ]
  },
  {
    "name": "messages",
